<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_vehicle_fine_tree" model="ir.ui.view">
        <field name="name">control.vehicle.fine.tree</field>
        <field name="model">control.vehicle.fine</field>
        <field name="arch" type="xml">
            <list string="Multas e Infracciones" expand="1" decoration-danger="pending_payment" decoration-success="fine_status == 'paid'" decoration-muted="fine_status == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="reason"/>
                <field name="amount" string="Monto / saldo ANT (USD)" sum="Total"/>
                <field name="pending_payment" column_invisible="1"/>
                <field name="fine_status" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_vehicle_fine_form" model="ir.ui.view">
        <field name="name">control.vehicle.fine.form</field>
        <field name="model">control.vehicle.fine</field>
        <field name="arch" type="xml">
            <form string="Multa / Infracción">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <widget name="web_ribbon" title="Pagada" bg_color="bg-success" invisible="not paid"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Detalles de Infracción">
                            <field name="vehicle_id"/>
                            <field name="date"/>
                            <field name="reason"/>
                            <field name="amount"/>
                            <field name="paid" widget="boolean_toggle"/>
                        </group>
                        <group string="Responsable Asociado">
                            <field name="assignment_id" domain="[('vehicle_id', '=', vehicle_id)]"/>
                            <field name="driver_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observaciones">
                            <field name="notes" placeholder="Agrega aquí más detalles de la infracción o el comprobante de pago..."/>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_vehicle_fine_search" model="ir.ui.view">
        <field name="name">control.vehicle.fine.search</field>
        <field name="model">control.vehicle.fine</field>
        <field name="arch" type="xml">
            <search string="Buscar Multas">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="assignment_id"/>
                <field name="driver_id"/>
                <field name="reason"/>
                <filter string="Vehículos activos" name="active_vehicles" domain="[('vehicle_id.active', '=', True)]"/>
                <separator/>
                <filter string="Pendientes de pago" name="pending" domain="[('pending_payment', '=', True)]"/>
                <filter string="Pagadas" name="paid" domain="[('fine_status', '=', 'paid')]"/>
                <filter string="Anuladas" name="cancelled" domain="[('fine_status', '=', 'cancelled')]"/>
                <filter string="En impugnación" name="disputed" domain="[('fine_status', '=', 'disputed')]"/>
                <filter string="En convenio" name="agreement" domain="[('fine_status', '=', 'agreement')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Vehículo" name="group_by_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Conductor" name="group_by_driver" context="{'group_by': 'driver_id'}"/>
                    <filter string="Año" name="group_by_year" context="{'group_by': 'date:year'}"/>
                    <filter string="Mes" name="group_by_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vehicle_fine" model="ir.actions.act_window">
        <field name="name">Multas de Tránsito</field>
        <field name="res_model">control.vehicle.fine</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vehicle_fine_search"/>
        <field name="context">{'search_default_group_by_vehicle': 1, 'search_default_active_vehicles': 1}</field>
    </record>


</odoo>
