<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_maintenance_tree" model="ir.ui.view">
        <field name="name">control.vehicle.maintenance.tree</field>
        <field name="model">control.vehicle.maintenance</field>
        <field name="arch" type="xml">
            <list expand="1" string="Mantenimientos de vehículo" decoration-danger="is_overdue" decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="maintenance_type" widget="badge"/>
                <field name="workshop"/>
                <field name="responsible_id"/>
                <field name="last_km"/>
                <field name="next_km"/>
                <field name="current_km"/>
                <field name="remaining_km" string="Faltante (km)"/>

                <field name="cost" widget="monetary"/>
                <field name="is_overdue" invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state in ['scheduled', 'in_progress']" decoration-danger="is_overdue"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_maintenance_form" model="ir.ui.view">
        <field name="name">control.vehicle.maintenance.form</field>
        <field name="model">control.vehicle.maintenance</field>
        <field name="arch" type="xml">
            <form string="Mantenimiento de Vehículo">
                <header>
                    <button name="action_start" type="object" string="Iniciar mantenimiento" invisible="not id or state != 'scheduled'" class="btn-primary" icon="fa-play"/>
                    <button name="action_complete" type="object" string="Marcar como realizado" invisible="not id or state not in ['scheduled', 'in_progress']" class="btn-success" icon="fa-check"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="not id or state in ['done', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,in_progress,done"/>
                </header>
                <sheet>
                    <div class="alert alert-danger mb-3" role="status" invisible="not is_overdue">
                        <strong>Mantenimiento Vencido:</strong> El kilometraje actual del vehículo superó el objetivo programado.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Descripción del mantenimiento"/>
                        <h1><field name="name" placeholder="Ej.: Cambio de aceite y filtro de 50.000 km"/></h1>
                    </div>
                    <group>
                        <group string="Detalles del Mantenimiento">
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="maintenance_type"/>
                            <field name="workshop" placeholder="Ej.: Taller Central Toyota"/>
                            <field name="responsible_id"/>
                        </group>
                        <group string="Control de Kilometraje">
                            <field name="date"/>
                            <field name="last_km" string="Último mantenimiento (km)"/>
                            <field name="next_km" string="Próximo mantenimiento (km)"/>
                            <field name="current_km" string="Kilometraje actual vehículo"/>
                            <field name="remaining_km" string="Kilometraje restante"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <group string="Costos y Observaciones">
                        <group>
                            <field name="cost" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="notes" placeholder="Detalles de repuestos cambiados, facturas, observaciones…"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vehicle_maintenance" model="ir.actions.act_window">
        <field name="name">Mantenimientos</field>
        <field name="res_model">control.vehicle.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
