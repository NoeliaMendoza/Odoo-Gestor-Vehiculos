<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_cost_tree" model="ir.ui.view">
        <field name="name">control.vehicle.cost.tree</field>
        <field name="model">control.vehicle.cost</field>
        <field name="arch" type="xml">
            <list string="Costos y gastos de vehículos" editable="bottom">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="cost_type" widget="badge"/>
                <field name="name"/>
                <field name="amount" widget="monetary" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_cost_form" model="ir.ui.view">
        <field name="name">control.vehicle.cost.form</field>
        <field name="model">control.vehicle.cost</field>
        <field name="arch" type="xml">
            <form string="Registro de Costo">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Concepto de costo"/>
                        <h1><field name="name" placeholder="Ej.: Combustible Diésel / Seguro anual"/></h1>
                    </div>
                    <group>
                        <group string="Detalles del Gasto">
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="cost_type"/>
                            <field name="date"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Vínculos">
                            <field name="maintenance_id" readonly="1" invisible="not maintenance_id"/>
                            <field name="usage_id" readonly="1" invisible="not usage_id"/>
                        </group>
                    </group>
                    <group string="Observaciones">
                        <field name="notes" placeholder="Notas de factura, proveedor, kilometraje al momento del gasto…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vehicle_cost" model="ir.actions.act_window">
        <field name="name">Costos de vehículo</field>
        <field name="res_model">control.vehicle.cost</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
